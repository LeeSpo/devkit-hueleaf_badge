<resources>
    <style name="Theme.HueLeaf" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hl_primary</item>
        <item name="colorOnPrimary">@color/hl_on_primary</item>
        <item name="colorPrimaryContainer">@color/hl_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/hl_on_primary_container</item>
        <item name="colorSecondary">@color/hl_secondary</item>
        <item name="colorOnSecondary">@color/hl_on_secondary</item>
        <item name="colorSecondaryContainer">@color/hl_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/hl_on_secondary_container</item>
        <item name="android:colorBackground">@color/hl_surface</item>
        <item name="colorSurface">@color/hl_surface</item>
        <item name="colorOnSurface">@color/hl_on_surface</item>
        <item name="colorSurfaceVariant">@color/hl_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/hl_on_surface_variant</item>
        <item name="colorOutline">@color/hl_outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/hl_surface</item>
        <item name="android:windowLightStatusBar">@bool/hl_light_system_bars</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Widget.HueLeaf.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Widget.HueLeaf.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.HueLeaf.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="TextAppearance.HueLeaf.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.HueLeaf.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.HueLeaf.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
