menu "HueLeaf gallery"

config HL_MONO_FAST
    bool "MonoFast black/white refresh for UI screens (FrameFilm-derived)"
    default y
    help
        Picker, messages and other non-image screens use the FrameFilm MonoFast
        RAM waveform. This option compiles the experimental support; runtime
        remains OFF unless the current TF hueleaf.cfg explicitly contains
        mono_fast=1. A prior NVS ON setting is not sufficient. Images always
        use the stock six-ink OTP waveform. Hardware compatibility and lifetime
        have not been validated on this board.

config HL_MONO_FAST_CLEAN_EVERY
    int "MonoFast frames between mono_clear cleanups"
    depends on HL_MONO_FAST
    range 1 1000
    default 20

endmenu
